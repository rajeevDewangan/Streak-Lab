{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "streak-lab",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-05-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
	// Optional, add later if you want ISR/cache or image optimization:
	//   - "services" self-reference + "r2_buckets" → see https://opennext.js.org/cloudflare/caching
	//   - "images": { "binding": "IMAGES" } → see https://opennext.js.org/cloudflare/howtos/image
}
